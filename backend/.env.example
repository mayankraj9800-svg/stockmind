PORT=3001
ALLOWED_ORIGINS=https://aistocksmind.netlify.app,http://localhost:3000
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_TIMEOUT_MS=8000
FINNHUB_RETRIES=2
